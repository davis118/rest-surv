# Backend settings. The backend reads these from its environment; it does not load
# a .env file itself. Locally, export them in your shell before starting uvicorn.
# On Cloud Run, set them with --set-env-vars or in the console.
#
# No keys or passwords are needed: every model runs locally.

# Sites allowed to call the REST API from a browser, comma-separated.
# Defaults to * (any site) when unset, which is fine for local development.
# In production, set it to the frontend's origin.
ALLOWED_ORIGINS=https://your-frontend.example.vercel.app

# Port to listen on. Cloud Run sets this for you.
PORT=8080
