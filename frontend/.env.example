# Frontend settings. Copy to frontend/.env.local to use them.
#
# Leave this unset for local development: Vite then proxies /ws and /api to the
# backend on http://127.0.0.1:8000.
#
# For a deployed build, set it to the backend's https origin (no trailing slash).
# On Vercel, add it under Project Settings > Environment Variables instead.
VITE_BACKEND_URL=https://your-backend.example.run.app
